<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <!--
      The drop's bounding box is y 28..68, so its centre sat at 48 on a canvas
      whose centre is 54: six units high, which reads as the drop drifting
      toward the top of the tile. Translated rather than redrawn, so the path
      stays the shape that was designed.
    -->
    <group android:translateY="6">
        <path
            android:fillColor="#FFFBFDF8"
            android:pathData="M54,28c0,0 -14,16 -14,26a14,14 0 1,0 28,0c0,-10 -14,-26 -14,-26z" />
    </group>
</vector>
